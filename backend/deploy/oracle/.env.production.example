# Backend runtime
NODE_ENV=production
PORT=5001
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h

# MySQL (same VM or managed DB)
DB_HOST=127.0.0.1
DB_USER=medical_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=medical_suivi

# Patient medical assistant (store real values only in the server secret manager)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MEDICAL_CHAT_ENCRYPTION_KEY=
